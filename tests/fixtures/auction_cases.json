{
  "schema_version": 1,
  "purpose": "DEMO / TEST ONLY; no production files",
  "roster": {
    "coach_file": "examples/final_project/coach.csv",
    "member_file": "examples/final_project/member.csv",
    "path_base": "repository_root"
  },
  "contract": {
    "initial": "Full logical state injected by adapter; no disk or network side effects. Missing bid keys mean no bid. lastAwardUndo is injected runtime state, not a legacy JSON field.",
    "steps": "Operations are harness-neutral semantic names, not an implemented Python API. validate_bid does not mutate; submit_bid checks running and replaces only a valid amount. select_winner selects without deducting budget. start_auction resets bids then applies automatic minimum bids. pause/resume do not advance clock.",
    "expected": "Partial recursive assertions; only provided fields are checked. For bids/budgets, provided keys are checked; history arrays must match length and records (record fields are partial). error_category is a harness normalization of Node error messages, not a current Node wire code. candidates is derived in insertion order.",
    "rng_values": "Inject Math.random-style values [0,1); use floor(value * candidate_count). Python adapter must use the same deterministic selection mapping.",
    "safety": "Never execute original server entrypoint against data/. Phase 1 adapter must stub persistence, clock, network and inject demo roster.",
    "legacy_defects": "Not parity requirements; see docs/FINAL_PROJECT_RULES_BASELINE.md."
  },
